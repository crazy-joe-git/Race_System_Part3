@model IEnumerable<Race_System_2_.Models.EventViewModel>
@{
    ViewData["Title"] = "Browse Races";
    var userRole = Context.Session.GetString("UserRole");
    bool isOrganiser = userRole == "Organiser" || userRole == "Organizer";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Browse Available Races</h2>
        <p class="text-muted">Explore upcoming running events and register to participate.</p>
    </div>
    @if (isOrganiser)
    {
        <a asp-action="Create" class="btn btn-primary fw-semibold">
            <i class="fa-solid fa-circle-plus me-1"></i> Create New Event
        </a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm mb-4">@TempData["SuccessMessage"]</div>
}

<div class="row row-cols-1 row-cols-md-3 g-4">
    @if (Model != null && Model.Any())
    {
        foreach (var race in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-3">
                    <div class="card-body d-flex flex-column">
                        <h4 class="card-title fw-bold text-dark mb-2">@race.EventName</h4>
                        <p class="text-muted small mb-3">
                            <i class="fa-regular fa-calendar me-1"></i> @race.EventDate.ToString("yyyy-MM-dd")<br />
                            <i class="fa-solid fa-location-dot me-1"></i> @race.EventLocation
                        </p>
                        <p class="card-text text-secondary mb-4 flex-grow-1">@race.Description</p>

                        <div class="d-flex gap-2 mt-auto">
                            <a asp-action="Details" asp-route-id="@race.EventId" class="btn btn-outline-primary btn-sm w-100 fw-semibold">View Details</a>

                            @if (isOrganiser)
                            {
                                <a asp-action="Edit" asp-route-id="@race.EventId" class="btn btn-outline-secondary btn-sm px-3">Edit</a>
                            }
                            else
                            {
                                <a asp-controller="Registrations" asp-action="Register" asp-route-eventId="@race.EventId" class="btn btn-primary btn-sm w-100 fw-semibold">Enrol Now</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <p class="text-muted fs-5">No race events currently available.</p>
        </div>
    }
</div>
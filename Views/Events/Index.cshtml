@model IEnumerable<Race_System_2_.Models.EventViewModel>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-primary mb-1">📊 Organiser Dashboard</h1>
            <p class="text-muted mb-0">Manage race events and view published details.</p>
        </div>
        <div>
            <a class="btn btn-primary fw-bold px-4 py-2 shadow-sm" asp-action="Create">
                ➕ Create New Event
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Metric Summary Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
                <div class="card-body">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Total Events Managed</div>
                    <h2 class="fw-extrabold text-dark display-6 mb-0">@(Model?.Count() ?? 0)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
                <div class="card-body">
                    <div class="text-muted small fw-bold text-uppercase mb-1">System Status</div>
                    <h2 class="fw-extrabold text-success display-6 mb-0">Operational</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Events Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom">
            <h3 class="h5 fw-bold text-dark mb-0">Your Created Events</h3>
        </div>
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted mb-0">No events found. Click "Create New Event" above to add one.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase fs-7">
                            <tr>
                                <th class="py-3 px-4">Event Name</th>
                                <th class="py-3">Description</th>
                                <th class="py-3">Date & Time</th>
                                <th class="py-3">Location</th>
                                <th class="py-3">Distance</th>
                                <th class="py-3">Type</th>
                                <th class="py-3">Organiser</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="py-3 px-4 fw-bold text-dark">@item.Name</td>
                                    <td class="py-3 text-muted small">@item.Description</td>
                                    <td class="py-3 text-muted">@item.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="py-3 text-muted">@item.Location</td>
                                    <td class="py-3"><span class="badge bg-secondary">@item.Distance km</span></td>
                                    <td class="py-3"><span class="badge bg-info text-dark">@item.EventType</span></td>
                                    <td class="py-3 text-muted">@item.OrganizerName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
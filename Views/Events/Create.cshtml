@model Race_System_2_.Models.EventViewModel
@{
    ViewData["Title"] = "Create Race Event";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="fw-bold text-primary mb-0">➕ Create New Race Event</h2>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm fw-bold">← Back to Dashboard</a>
                </div>
                <p class="text-muted mb-4">Fill out the details below to publish a new event for participants to discover and enrol in.</p>

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Event Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Soweto Half Marathon 2026" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Provide full details about route, water points, and start times..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Date" class="form-label fw-semibold">Event Date & Time</label>
                            <input asp-for="Date" class="form-control" type="datetime-local" required />
                            <span asp-validation-for="Date" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label fw-semibold">Location / Venue</label>
                            <input asp-for="Location" class="form-control" placeholder="e.g. FNB Stadium, Johannesburg" required />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Distance" class="form-label fw-bold">Race Distance</label>
                            <input asp-for="Distance" class="form-control" placeholder="e.g. 3, 5, or 21.1" />
                            <span asp-validation-for="Distance" class="text-danger small"></span>
                            <div class="form-text">Enter value (e.g. 3 for 3km).</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EventType" class="form-label fw-semibold">Event Type</label>
                            <input asp-for="EventType" class="form-control" placeholder="e.g. Running, Trail, Road, Walk" required />
                            <span asp-validation-for="EventType" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Azure Blob Storage Image Upload Field -->
                    <div class="card bg-light border-0 p-3 mb-4 rounded-3">
                        <label class="form-label fw-semibold text-dark">🖼️ Event Banner Image (Azure Blob Storage Integration)</label>
                        <input type="file" name="bannerImage" class="form-control" accept="image/*" />
                        <div class="form-text text-muted small">Upload an image banner for the race page (JPEG/PNG).</div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light fw-bold px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm">Publish Event</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
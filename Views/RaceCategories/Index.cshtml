@model IEnumerable<Race_System_2_.Models.RaceCategoryViewModel>
@{
    ViewData["Title"] = "Race Categories";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-primary mb-1">Race Categories</h1>
            <p class="text-muted mb-0">Manage distance and age categories for events.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary fw-bold px-4 py-2 shadow-sm">Add New Category</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4">@TempData["SuccessMessage"]</div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted mb-0">No race categories configured yet.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase fs-7">
                            <tr>
                                <th class="py-3 px-4">Category Name</th>
                                <th class="py-3">Distance</th>
                                <th class="py-3">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in Model)
                            {
                                <tr>
                                    <td class="py-3 px-4 fw-bold text-dark">@cat.CategoryName</td>
                                    <td class="py-3"><span class="badge bg-secondary">@cat.Distance km</span></td>
                                    <td class="py-3 text-muted">@cat.CategoryDescription</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
@model IEnumerable<Race_System_2_.Models.RaceCategoryViewModel>
@{
    ViewData["Title"] = "Race Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Race Categories</h2>
        <p class="text-muted">Manage all race categories, distances, and descriptions.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold"><i class="fa-solid fa-plus me-1"></i> Add Category</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm mb-4">@TempData["SuccessMessage"]</div>
}

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 px-4">Category Name</th>
                        <th class="py-3">Distance (km)</th>
                        <th class="py-3">Description</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var cat in Model)
                        {
                            <tr>
                                <td class="py-3 px-4 fw-bold">@cat.CategoryName</td>
                                <td class="py-3">@cat.Distance km</td>
                                <td class="py-3 text-muted">@cat.CategoryDescription</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">No race categories configured yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
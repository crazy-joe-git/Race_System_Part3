@model Race_System_2_.Models.RaceCategoryViewModel
@{
    ViewData["Title"] = "Add Category";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h2 class="fw-bold text-primary mb-3">Add Race Category</h2>
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label fw-semibold">Category Name</label>
                        <input asp-for="CategoryName" class="form-control" placeholder="e.g. Senior Open, Junior 5km" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Distance" class="form-label fw-semibold">Distance (km)</label>
                        <input asp-for="Distance" class="form-control" type="number" step="0.1" placeholder="e.g. 5 or 21.1" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryDescription" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="CategoryDescription" class="form-control" rows="3" placeholder="Category details..."></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light fw-bold px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm">Save Category</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@model IEnumerable<Race_System_2_.Models.ResultViewModel>
@{
    ViewData["Title"] = "My Results";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="fw-bold text-primary mb-1">My Results</h1>
        <p class="text-muted">Review your official finish times and rankings across completed race events.</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5">
            <div class="card-body">
                <h3 class="text-muted h5">No recorded results found yet.</h3>
                <p class="text-muted small">Your official finish times will appear here once published by race organisers.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase fs-7">
                            <tr>
                                <th class="py-3 px-4">Result ID</th>
                                <th class="py-3">Registration ID</th>
                                <th class="py-3">Finish Time</th>
                                <th class="py-3 text-end px-4">Position</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in Model)
                            {
                                <tr>
                                    <td class="py-3 px-4 fw-bold">#@res.ResultId</td>
                                    <td class="py-3 text-muted">Registration #@res.RegistrationId</td>
                                    <td class="py-3 fw-semibold text-dark">@res.FinishTime</td>
                                    <td class="py-3 text-end px-4">
                                        <span class="badge bg-success px-3 py-2">Position @res.Position</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
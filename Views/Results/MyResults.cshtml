@{
    ViewData["Title"] = "My Results";
}
<div class="container mt-4">
    <h2 class="fw-bold mb-3">My Race Results</h2>
    <p class="text-muted">Review your official finish positions, split times, and verified race milestones.</p>
    <div class="card shadow-sm p-4">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Race Name</th>
                    <th>Date</th>
                    <th>Finish Time</th>
                    <th>Position</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>East London Summer Run</td>
                    <td>2026-12-12</td>
                    <td>00:45:12</td>
                    <td>#14 / 250</td>
                    <td><span class="badge bg-success">Verified</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
@model Race_System_2_.Models.ResultViewModel
@{
    ViewData["Title"] = "Capture Race Results";
}

<div class="container py-3">
    <h2 class="fw-bold mb-1">Capture Race Results</h2>
    <p class="text-muted mb-4">Record official finish times and finish positions for participants.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4">@TempData["SuccessMessage"]</div>
    }

    <div class="card shadow-sm border-0 p-4" style="max-width: 600px;">
        <form asp-action="Capture" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="RegistrationId" class="form-label fw-semibold">Registration ID</label>
                <input asp-for="RegistrationId" class="form-control" type="number" placeholder="Enter Registration ID" required />
                <span asp-validation-for="RegistrationId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FinishTime" class="form-label fw-semibold">Finish Time (hh:mm:ss)</label>
                <input asp-for="FinishTime" class="form-control" placeholder="00:45:30" required />
                <span asp-validation-for="FinishTime" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Position" class="form-label fw-semibold">Official Position</label>
                <input asp-for="Position" class="form-control" type="number" placeholder="1" required />
                <span asp-validation-for="Position" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">Publish Result</button>
                <a asp-controller="Events" asp-action="OrganizerDashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
            </div>
        </form>
    </div>
</div>
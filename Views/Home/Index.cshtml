@{
    ViewData["Title"] = "Home Page";
}

<div class="p-5 mb-4 bg-dark text-white rounded-3 shadow-lg position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);">
    <div class="container-fluid py-5">
        <span class="badge bg-warning text-dark mb-3 px-3 py-2 fw-semibold">RaceDay</span>
        <h1 class="display-4 fw-bold mb-3">Conquer Every Milestone with RaceDay</h1>
        <p class="col-md-8 fs-5 text-light mb-4">
            The ultimate platform connecting event organisers and runners. Seamless event creation, instant secure enrolments, and real-time finish tracking.
        </p>
        <div class="d-flex gap-3">
            <a class="btn btn-warning btn-lg px-4 fw-semibold text-dark" asp-controller="Events" asp-action="Index">Browse Races</a>
        </div>
        <p class="mt-4 text-muted fst-italic small">"You don't have to be extreme, just consistent."</p>
    </div>
</div>

<!-- Feature Grid -->
<div class="row g-4 py-3 row-cols-1 row-cols-md-3">
    <div class="col">
        <div class="card h-100 shadow-sm border-0 p-3">
            <div class="card-body">
                <div class="text-primary mb-3 fs-3"><i class="fa-solid fa-ticket"></i></div>
                <h3 class="h5 fw-bold">Seamless Race Registration</h3>
                <p class="text-muted">Easily browse upcoming marathons, sprints, and trail runs. Join events with a single click and manage your personal schedule.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 shadow-sm border-0 p-3">
            <div class="card-body">
                <div class="text-primary mb-3 fs-3"><i class="fa-solid fa-sliders"></i></div>
                <h3 class="h5 fw-bold">Comprehensive Management</h3>
                <p class="text-muted">Organisers get powerful tools to build event rosters, configure categories, upload banners via Azure Blob Storage, and track runner statistics.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 shadow-sm border-0 p-3">
            <div class="card-body">
                <div class="text-primary mb-3 fs-3"><i class="fa-solid fa-stopwatch"></i></div>
                <h3 class="h5 fw-bold">Live Timing & Milestones</h3>
                <p class="text-muted">Stay motivated by tracking your personal best times, reviewing official finish positions, and viewing verified results.</p>
            </div>
        </div>
    </div>
</div>


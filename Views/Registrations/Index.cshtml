@model IEnumerable<Race_System_2_.Models.RegistrationViewModel>
@{
    ViewData["Title"] = "My Enroled Races";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="fw-bold text-primary mb-1">🎟️ My Enroled Races</h1>
        <p class="text-muted">Track your active event registrations and enrolment status.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5">
            <div class="card-body">
                <h3 class="text-muted h5">You haven't enroled in any race events yet.</h3>
                <a asp-controller="Events" asp-action="Browse" class="btn btn-primary fw-bold mt-2">🏃‍♂️ Browse Races</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <h3 class="h5 fw-bold text-dark mb-0">Active Registrations</h3>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase fs-7">
                            <tr>
                                <th class="py-3 px-4">Registration ID</th>
                                <th class="py-3">Race ID</th>
                                <th class="py-3">Bib Number</th>
                                <th class="py-3">Enroled Date</th>
                                <th class="py-3 text-center">Status</th>
                                <th class="py-3 text-end px-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reg in Model)
                            {
                                <tr>
                                    <td class="py-3 px-4 fw-bold">#@reg.RegistrationId</td>
                                    <td class="py-3 text-muted">Event #@reg.EventRaceId</td>
                                    <td class="py-3 fw-semibold text-primary">Bib #@reg.BidNumber</td>
                                    <td class="py-3 text-muted">@reg.RegDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="py-3 text-center">
                                        @if (reg.PaymentStatus.Equals("Paid", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2">Paid</span>
                                        }
                                        else if (reg.PaymentStatus.Equals("Confirmed", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success px-3 py-2">Confirmed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2">@reg.PaymentStatus</span>
                                        }
                                    </td>
                                    <td class="py-3 text-end px-4">
                                        @if (!reg.PaymentStatus.Equals("Paid", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <form asp-action="MarkPaid" asp-route-id="@reg.RegistrationId" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-warning fw-semibold">💳 Pay Now</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
@model Microsoft.AspNetCore.Identity.IdentityUser
@{
    ViewData["Title"] = "User Profile";
    var profileImage = Context.Session.GetString("UserProfileImage");
}

<div class="container py-4">
    <h2 class="fw-bold mb-3">User Profile Management</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4">@TempData["SuccessMessage"]</div>
    }
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 rounded-3 p-4">
                <h4 class="mb-3 fw-bold text-dark">Account Details & Profile Picture</h4>

                <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
                    <div class="text-center mb-4">
                        <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center fw-bold shadow-sm mb-3" style="width: 90px; height: 90px; overflow: hidden; font-size: 2rem;">
                            @if (!string.IsNullOrEmpty(profileImage))
                            {
                                <img src="@profileImage" alt="Profile Picture" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <span>@(Model?.Email?.Substring(0, 1).ToUpper() ?? "U")</span>
                            }
                        </div>
                        <div class="mb-3 text-start">
                            <label for="profilePicture" class="form-label small fw-semibold text-muted">Upload New Profile Picture</label>
                            <input type="file" name="profilePicture" id="profilePicture" class="form-control form-control-sm" accept="image/*" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address</label>
                        <input type="text" class="form-control bg-light" value="@Model?.Email" disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phone Number</label>
                        <input type="text" name="phoneNumber" class="form-control" value="@Model?.PhoneNumber" />
                    </div>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Changes</button>
                </form>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 rounded-3 p-4">
                <h4 class="mb-3 fw-bold text-dark">Change Password</h4>
                <form asp-action="ChangePassword" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Current Password</label>
                        <input type="password" name="currentPassword" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Password</label>
                        <input type="password" name="newPassword" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-warning px-4 fw-semibold text-dark">Update Password</button>
                </form>
            </div>
        </div>
    </div>
</div>